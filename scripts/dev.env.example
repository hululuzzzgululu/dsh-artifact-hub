# Copy this file to scripts/dev.env to override local-development defaults.

# Hub API
HUB_HOST=127.0.0.1
HUB_PORT=8000
HUB_URL=http://127.0.0.1:8000
HUB_BASE_URL=http://127.0.0.1:5173
HUB_STORAGE_MODE=sqlite
# HUB_ARTIFACT_ROOT=/absolute/path/to/artifacts
# HUB_DATABASE_PATH=/absolute/path/to/hub.sqlite3

# Public share frontend
SHARE_WEB_HOST=127.0.0.1
SHARE_WEB_PORT=5173
SHARE_WEB_URL=http://127.0.0.1:5173

# DSH Web and plugin identity
DSH_PROFILE=web
DSH_WEB_HOST=127.0.0.1
DSH_WEB_PORT=3080
DSH_WEB_URL=http://127.0.0.1:3080
DSH_ARTIFACT_HUB_CREATED_BY=dsh-local-user
DSH_ARTIFACT_HUB_MODE=local
# Required when DSH_ARTIFACT_HUB_MODE=nas. Defaults to HUB_ARTIFACT_ROOT in scripts/dev.sh.
# DSH_ARTIFACT_HUB_ARTIFACT_ROOT=/absolute/path/to/the/dsh-side/nas/mount

STARTUP_TIMEOUT_SECONDS=60
